# Telnyx SMS Inbox 1.0 - example configuration
# Copy this file to .env and fill in your own values.
# Never commit a real .env file. Never put a real API key in this file.

# Telnyx API key, from the Telnyx Mission Control Portal, API Keys / Auth V2.
# Sent only as Authorization: Bearer <key> to https://api.telnyx.com/v2
TELNYX_API_KEY=YOUR_TELNYX_API_KEY_HERE

# Your Telnyx US phone number in E.164 format, shown in the inbox header.
TELNYX_PHONE_NUMBER=+15551234567

# Password that protects the web interface. Choose a long, random password.
APP_PASSWORD=change-me-to-a-long-random-password

# Automatic refresh interval in seconds. Recommended 10 to 15.
POLL_INTERVAL=15

# How many of the most recent inbound messages to display. Default 3.
MESSAGE_LIMIT=3

# IANA timezone used to display message timestamps, for example Europe/Rome.
TIMEZONE=UTC
